# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y actualiza con tus credenciales seguras de desarrollo/producción
# ============================================================================

# Entorno y Puerto de la API NestJS
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Secretos Criptográficos (IMPORTANTE: Genera claves aleatorias de 32+ caracteres para producción)
JWT_SECRET=tu_super_secreto_jwt_para_tokens_de_acceso
JWT_REFRESH_SECRET=tu_super_secreto_jwt_para_tokens_de_refresh
TWO_FACTOR_ENCRYPTION_KEY=tu_clave_de_encriptacion_aes_256_de_32_bytes_para_2fa

# Configuración del contenedor PostgreSQL (Docker)
DB_USER=postgres
DB_PASSWORD=MySecretPassword123
DB_NAME=sistema_db
DB_PORT=5432

# URL de conexión directa para Prisma ORM
DATABASE_URL="postgresql://postgres:MySecretPassword123@localhost:5432/sistema_db?schema=public"

# Configuración de Connection Pooling PostgreSQL (Alta Concurrencia)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_POOL_TIMEOUT_MS=5000

# ============================================================================
# Configuración de Réplica de Lectura y Streaming Replication (Opcional / Opt-In)
# Si se define DATABASE_REPLICA_URL, Prisma enruta lecturas a la réplica automáticamente.
# Si se deja vacía o sin definir, hace fallback transparente al primario sin errores.
# Para levantar la réplica local en Docker: docker compose --profile with-replica up -d
# ============================================================================
# DB_REPLICA_PORT=5433
# DATABASE_REPLICA_URL="postgresql://postgres:MySecretPassword123@localhost:5433/sistema_db?schema=public"
# REPLICATION_USER=replicator
# REPLICATION_PASSWORD=replica_secure_pass_123

# Configuración del contenedor Redis (Caché, Rate Limit, Blacklist, Tokens 2FA)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=MyRedisSecretPassword123

# Configuración Almacenamiento Compatible S3 (SeaweedFS / AWS S3 / MinIO)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=tu_access_key
S3_SECRET_KEY=tu_secret_key
S3_BUCKET=sistema-files
S3_FORCE_PATH_STYLE=true

# Configuración Antivirus ClamAV Daemon
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Credenciales de Acceso a la Documentación de la API (Scalar)
DOCS_USER=desarrollador
DOCS_PASSWORD=CambiaEstaContrasenaSegura_2026!

# Configuración de Envío de Correos Electrónicos (SMTP)
MAIL_DRIVER=smtp
MAIL_FROM='"Mi Sistema" <no-reply@tudominio.com>'
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu_contrasena_de_aplicacion_gmail

# Para usar OAuth2 con Gmail (Opcional):
# MAIL_DRIVER=oauth2
# MAIL_SERVICE=gmail
# MAIL_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# MAIL_CLIENT_SECRET=tu_google_client_secret
# MAIL_REFRESH_TOKEN=tu_refresh_token

# ============================================================================
# Configuración de Respaldos Automáticos (Docker Backups)
# ============================================================================
BACKUP_CRON_POSTGRES="0 2 * * *"     # Programación cron para backup de PostgreSQL (ej. 02:00 AM)
BACKUP_CRON_STORAGE="0 3 * * *"      # Programación cron para backup de archivos SeaweedFS (ej. 03:00 AM)
BACKUP_KEEP_DAYS=7                   # Días de retención para respaldos diarios
BACKUP_KEEP_WEEKS=4                  # Semanas de retención para respaldos semanales
BACKUP_KEEP_MONTHS=6                 # Meses de retención para respaldos mensuales
BACKUP_ON_START=false                # Si es true, ejecuta un respaldo inmediatamente al levantar el contenedor

