# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y actualiza con tus credenciales seguras de desarrollo/producción
# ============================================================================

# ============================================================================
# 0. Licencia & Control de Activación de Instancia (Gatekeeper)
# ============================================================================
# Llave maestra requerida para arrancar el backend en entornos dev/prod.
# Para solicitar una llave de activación o licencia comercial, contactar al autor:
# Manuel Eduardo Santiago Feria (Nano-DevCode) -> mayka708.ms@gmail.com
SYSTEM_ACTIVATION_KEY=SOLICITAR_LLAVE_AL_AUTOR_NANO_DEVCODE

# ============================================================================
# 1. Configuración de Entorno y Servidor NestJS
# ============================================================================
NODE_ENV=development
PORT=3000
APP_NAME="Sistema Core"
APP_URL=https://sistema.nano-service.com
FRONTEND_URL="https://sistema.nano-service.com,http://localhost:5173,http://localhost:5174,http://localhost:3000"
ALLOWED_ORIGINS="https://sistema.nano-service.com,http://localhost:5173,http://localhost:5174,http://localhost:3000"

# ============================================================================
# 2. Secretos Criptográficos y Autenticación (JWT, 2FA & Password Salt)
# ============================================================================
JWT_SECRET=tu_super_secreto_jwt_para_tokens_de_acceso
JWT_REFRESH_SECRET=tu_super_secreto_jwt_para_tokens_de_refresh
TWO_FACTOR_ENCRYPTION_KEY=tu_clave_de_encriptacion_aes_256_de_32_bytes_para_2fa

# Rondas de sal / cost factor para encriptación de contraseñas con bcrypt (Recomendado: 10 a 12)
BCRYPT_SALT_ROUNDS=10
# Sal personalizada opcional (si se deja vacío, bcrypt genera la sal automáticamente basada en BCRYPT_SALT_ROUNDS)
# BCRYPT_SALT=

# ============================================================================
# 3. Base de Datos PostgreSQL 16 y Pool de Conexiones
# ============================================================================
DB_USER=postgres
DB_PASSWORD=MySecretPassword123
DB_NAME=sistema_db
DB_PORT=5432

# URL de conexión directa para Prisma ORM
DATABASE_URL="postgresql://postgres:MySecretPassword123@localhost:5432/sistema_db?schema=public"

# Configuración de Connection Pooling PostgreSQL (Alta Concurrencia)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_POOL_TIMEOUT_MS=5000

# ============================================================================
# Configuración de Réplica de Lectura y Streaming Replication (Opcional / Opt-In)
# Si se define DATABASE_REPLICA_URL, Prisma enruta lecturas a la réplica automáticamente.
# Si se deja vacía o sin definir, hace fallback transparente al primario sin errores.
# Para levantar la réplica local en Docker: docker compose --profile with-replica up -d
# ============================================================================
DB_REPLICA_PORT=5433
# DATABASE_REPLICA_URL="postgresql://postgres:MySecretPassword123@localhost:5433/sistema_db?schema=public"
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replica_secure_pass_123

# ============================================================================
# 4. Redis 7 (Caché, Rate-Limiting, Blacklist, Colas BullMQ y Tokens 2FA)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=MyRedisSecretPassword123

# ============================================================================
# 5. Almacenamiento Compatible S3 (SeaweedFS / AWS S3 / MinIO)
# ============================================================================
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_GRPC_PORT=9333
S3_REGION=us-east-1
S3_ACCESS_KEY=tu_access_key
S3_SECRET_KEY=tu_secret_key
S3_BUCKET=sistema-files
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_TOTAL_BYTES=53687091200

# ============================================================================
# 6. Antivirus ClamAV Daemon
# ============================================================================
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ============================================================================
# 7. Documentación de API (Scalar)
# ============================================================================
DOCS_USER=desarrollador
DOCS_PASSWORD=CambiaEstaContrasenaSegura_2026!

# ============================================================================
# 8. Configuración de Envío de Correos Electrónicos (SMTP / OAuth2)
# ============================================================================
MAIL_DRIVER=smtp
MAIL_FROM='"Mi Sistema" <no-reply@tudominio.com>'

# Servidor SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# Credenciales
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu_contrasena_de_aplicacion_gmail

## Para usar OAuth2 con Gmail (Opcional):
# MAIL_DRIVER=oauth2
# MAIL_FROM="Mi Sistema" <no-reply@tudominio.com>
# MAIL_SERVICE=gmail
# MAIL_USER=tu-correo@gmail.com
# MAIL_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# MAIL_CLIENT_SECRET=tu_google_client_secret
# MAIL_REFRESH_TOKEN=tu_refresh_token

# ============================================================================
# 9. Respaldos Automáticos (Docker Backups)
# ============================================================================
BACKUP_CRON_POSTGRES="0 2 * * *"     # Programación cron para backup de PostgreSQL (ej. 02:00 AM)
BACKUP_CRON_STORAGE="0 3 * * *"      # Programación cron para backup de archivos SeaweedFS (ej. 03:00 AM)
BACKUP_KEEP_DAYS=7                   # Días de retención para respaldos diarios
BACKUP_KEEP_WEEKS=4                  # Semanas de retención para respaldos semanales
BACKUP_KEEP_MONTHS=6                 # Meses de retención para respaldos mensuales
BACKUP_ON_START=false                # Si es true, ejecuta un respaldo inmediatamente al levantar el contenedor

# ============================================================================
# 10. Perímetro de Seguridad SSL / NGINX / Certbot / Fail2Ban
# ============================================================================
DOMAIN=localhost                     # Dominio FQDN para el certificado SSL (ej. api.tudominio.com)
CERTBOT_EMAIL=admin@tudominio.com    # Correo para avisos de renovación de Let's Encrypt
F2B_LOG_LEVEL=INFO                   # Nivel de log para Fail2ban (CRITICAL, ERROR, WARNING, NOTICE, INFO, DEBUG)

# ============================================================================
# 11. Configuración de Aplicación Móvil y Soporte
# ============================================================================
SUPPORT_EMAIL=soporte@tudominio.com
TERMS_URL=https://tudominio.com/terminos-y-condiciones
PRIVACY_URL=https://tudominio.com/aviso-de-privacidad
API_BASE_URL=http://localhost:3000/api

# Control de versiones mínimas y forzadas para la app móvil
MOBILE_MIN_VERSION_ANDROID=1.0.0
MOBILE_MIN_VERSION_IOS=1.0.0
MOBILE_LATEST_VERSION_ANDROID=1.2.0
MOBILE_LATEST_VERSION_IOS=1.2.0
MOBILE_STORE_URL_ANDROID="https://play.google.com/store/apps/details?id=com.sistema.app"
MOBILE_STORE_URL_IOS="https://apps.apple.com/app/sistema/id123456789"
MOBILE_RELEASE_NOTES="Mejoras de rendimiento, estabilidad y sincronización en terreno"
MOBILE_MAINTENANCE_MODE=false

# ============================================================================
# 12. Exposición a Internet vía Cloudflare Tunnel (cloudflared)
# ============================================================================
# Opción A (Recomendada con Dominio Propio): Pega el Token del túnel creado en Cloudflare Zero Trust:
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_tunnel_aqui

# Opción B (Túnel Rápido Gratuito Quick Tunnel sin cuenta ni dominio):
# Genera automáticamente una URL pública temporal https://*.trycloudflare.com apuntando a NGINX:
CLOUDFLARE_TUNNEL_COMMAND="tunnel --no-autoupdate --url https://nginx:443 --no-tls-verify"

# ============================================================================
# 13. Autenticación Social OAuth 2.0 (Google y Facebook / Meta)
# Requiere habilitar las Feature Flags correspondientes en el sistema.
# ============================================================================
# Google Cloud Console (OAuth 2.0 Client ID tipo Web Application):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://sistema.nano-service.com/api/auth/google/callback

# Meta for Developers (Facebook Login):
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://sistema.nano-service.com/api/auth/facebook/callback

# ============================================================================
# 14. Bot de Música Discord (AntiGravity) y Lavalink v4
# ============================================================================
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Nodo de Audio Lavalink v4 (Docker o Externo):
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Spotify API (Opcional, para resolución de playlists de Spotify):
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Token de autenticación de YouTube para Lavalink (evita bloqueos 429 de YouTube):
YOUTUBE_REFRESH_TOKEN=

